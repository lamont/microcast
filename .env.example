# Copy to .env (git-ignored). Real coordinates never go in git.
MICROCAST_HOME_LAT=37.7609
MICROCAST_HOME_LON=-122.4350

# Optional overrides
# MICROCAST_DATA_DIR=~/data/microcast
# MICROCAST_PLACES=config/places.local.yaml

# Point the catalog at Lakekeeper + MinIO/S3 later; when any of these are set
# they replace the local SQLite catalog. See docs/decisions.md D1.
# PYICEBERG_CATALOG__MICROCAST__TYPE=rest
# PYICEBERG_CATALOG__MICROCAST__URI=http://localhost:8181/catalog
# PYICEBERG_CATALOG__MICROCAST__WAREHOUSE=microcast
# PYICEBERG_CATALOG__MICROCAST__S3__ENDPOINT=http://localhost:9000
